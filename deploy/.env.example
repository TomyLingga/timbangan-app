# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored and holds every secret.
# Lines marked REQUIRED must have a value; the others may stay empty (empty means "use the default" or "off").
# docker compose reads this file for the ${...} values in docker-compose.yml.
# A value that contains a $ sign must be put in single quotes, e.g. ODOO_PASSWORD='...', or compose expands it.

# ---------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------

# REQUIRED. The one address of the whole system, without a trailing slash and without /api.
# Browser, phone app and weighbridge program all use it. It becomes NEXT_PUBLIC_API_URL of the web build
# and WEB_ORIGIN of the API (CORS, and the links for sharing a driver's location).
# A change needs a new build of the web image: docker compose build web && docker compose up -d
PUBLIC_URL=http://timbangan.example.com

# Address Caddy serves on. ":80" serves plain HTTP for any host name or IP address.
# For HTTPS put the host name or IP address alone, e.g. timbangan.example.com (see README.md).
SITE_ADDRESS=:80

# auto: Caddy's default (a public certificate for a domain name; nothing for ":80" or "http://...").
# internal: a certificate from Caddy's own authority, for a LAN name or IP address; devices must trust its root.
TLS_MODE=auto

# Road map tiles of the tracking page, inlined into the web build. Empty: the public OpenStreetMap server.
NEXT_PUBLIC_MAP_TILES_URL=

# ---------------------------------------------------------------------------
# Database (PostgreSQL 17 container)
# ---------------------------------------------------------------------------

# Name of the database user and of the database. Default: timbangan.
POSTGRES_USER=timbangan
POSTGRES_DB=timbangan
# REQUIRED. Letters and digits only: it is placed inside DATABASE_URL. Example: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# API: sign-in
# ---------------------------------------------------------------------------

# REQUIRED. Signs access tokens, at least 32 characters. Example: openssl rand -hex 32
JWT_SECRET=
# Lifetime of an access token in seconds (default 900) and of a refresh token in days (default 30).
ACCESS_TOKEN_TTL_S=
REFRESH_TOKEN_TTL_DAYS=

# Company portal sign-in for staff. All three are needed; otherwise the SSO routes answer 503.
# PORTAL_API_URL ends in /api.
PORTAL_API_URL=
PORTAL_WEB_URL=
PORTAL_APP_NAME=

# Portal emails, comma separated, that get EDIT on every active module at each portal sign-in. Empty: none.
BOOTSTRAP_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# API: Odoo (read only)
# ---------------------------------------------------------------------------

# All four are needed; otherwise the sync routes answer 503 and sync:odoo refuses to run.
ODOO_URL=
ODOO_DB=
# Numeric id of the Odoo user.
ODOO_UID=
ODOO_PASSWORD=
# stock.location id whose internal child locations are the storage tanks. Empty: the sync skips the tanks.
ODOO_TANK_PARENT_LOCATION_ID=

# ---------------------------------------------------------------------------
# API: driver registry (VCF)
# ---------------------------------------------------------------------------

# VCF_URL alone is enough to read the registry; sending drivers to it needs the account too.
VCF_URL=
VCF_USERNAME=
VCF_PASSWORD=

# ---------------------------------------------------------------------------
# API: voice of the weighbridge answers
# ---------------------------------------------------------------------------

# off (default): no audio, the weighbridge program shows the text with a tone.
# supertonic: Supertonic 3 on this server's CPU; the seven model files must be in deploy/storage/tts/.
TTS_ENGINE=off
# supertonic only. Voice F1..F5 or M1..M5 (default F2), speed 0.5 to 2 (default 1), CPU threads 1 to 32 (default 4).
TTS_VOICE=
TTS_SPEED=
TTS_THREADS=

# ---------------------------------------------------------------------------
# API: one-off import from the old weighbridge database
# ---------------------------------------------------------------------------

# postgres://user:password@host:5432/database. Opened read only, by legacy:import only; the server never opens it.
# Empty: the import refuses to start.
LEGACY_DATABASE_URL=

# ---------------------------------------------------------------------------
# Set by docker-compose.yml or the API image. Listed so the list is complete; do not set them here.
# ---------------------------------------------------------------------------
# DATABASE_URL      built from POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB, host db, port 5432
# WEB_ORIGIN        equal to PUBLIC_URL
# HOST              0.0.0.0
# PORT              3100 (reached only by Caddy, not published)
# FILE_STORAGE_DIR  /data/files      (volume api-files)
# TTS_CACHE_DIR     /data/tts-cache  (volume api-tts-cache)
# TTS_MODEL_DIR     /models/tts      (folder deploy/storage/tts, read only)
