# One public address for the browser, the phone app and the weighbridge program:
# /api/* goes to the API, everything else to the web app.
# SITE_ADDRESS and TLS_MODE come from deploy/.env through docker-compose.yml.

{
	# Caddy cannot add its root certificate to the trust store of the container; the README explains how to copy it out.
	skip_install_trust
}

# TLS_MODE=auto: Caddy's default. A domain name gets a public certificate; ":80" or "http://..." stays plain HTTP.
(tls-auto) {
}

# TLS_MODE=internal: a certificate from Caddy's own authority, for a LAN name or IP address.
(tls-internal) {
	tls internal
}

{$SITE_ADDRESS::80} {
	import tls-{$TLS_MODE:auto}

	# Server-sent events of the control room: flush every frame at once, never buffer.
	handle /api/control-room/stream {
		reverse_proxy api:3100 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:3100
	}

	handle {
		reverse_proxy web:3000
	}
}
