{
  "name": "timbangan-registrasi-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "user:create": "tsx --env-file-if-exists=.env src/cli/user-create.ts",
    "sync:odoo": "tsx --env-file-if-exists=.env src/cli/sync-odoo.ts",
    "sync:vcf": "tsx --env-file-if-exists=.env src/cli/sync-vcf.ts",
    "plan:import": "tsx --env-file-if-exists=.env src/control-room/plan-import.ts",
    "legacy:import": "tsx --env-file-if-exists=.env src/cli/legacy-import.ts",
    "cutover:opening": "tsx --env-file-if-exists=.env src/cli/cutover-opening.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.9",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "postgres": "4.1.1",
    "sherpa-onnx-node": "2.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
