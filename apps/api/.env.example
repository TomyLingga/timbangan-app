# Copy to .env and fill in. .env is never committed.
# Values in the process environment win over this file.

# HTTP server. Defaults: PORT 3100, HOST 127.0.0.1.
PORT=
HOST=

# pglite://memory, pglite://./.data/dev (a folder), or postgres://user:password@host:5432/database
DATABASE_URL=

# Signs access tokens. At least 32 characters.
JWT_SECRET=

# The web app allowed to call this API with cookies. Default: http://localhost:3000.
WEB_ORIGIN=

# Defaults: 900 seconds and 30 days.
ACCESS_TOKEN_TTL_S=
REFRESH_TOKEN_TTL_DAYS=

# Odoo 13 JSON-RPC, read only. All four are needed; otherwise the sync routes answer 503.
ODOO_URL=
ODOO_DB=
ODOO_UID=
ODOO_PASSWORD=

# Company portal sign-in for staff. All three are needed; otherwise the SSO routes answer 503.
# PORTAL_API_URL ends in /api.
PORTAL_API_URL=
PORTAL_WEB_URL=
PORTAL_APP_NAME=

# Central driver registry (used by a later slice).
VCF_URL=
VCF_USERNAME=
VCF_PASSWORD=
