# Copy to .env and fill in. .env is never committed.
# Values in the process environment win over this file.

# HTTP server. Defaults: PORT 3100, HOST 127.0.0.1.
PORT=
HOST=
# true when the API sits behind one reverse proxy (for example Caddy): the client address in sessions and the
# audit log is then taken from the proxy's X-Forwarded-For header. Leave empty (false) when browsers reach the API
# directly, or anyone could write that header. Default: false.
TRUST_PROXY=

# pglite://memory, pglite://./.data/dev (a folder), or postgres://user:password@host:5432/database
DATABASE_URL=

# Signs access tokens. At least 32 characters.
JWT_SECRET=

# The web app allowed to call this API with cookies. Default: http://localhost:3000.
WEB_ORIGIN=

# Defaults: 900 seconds and 30 days.
ACCESS_TOKEN_TTL_S=
REFRESH_TOKEN_TTL_DAYS=

# Odoo 13 JSON-RPC, read only. All four are needed; otherwise the sync routes answer 503.
ODOO_URL=
ODOO_DB=
ODOO_UID=
ODOO_PASSWORD=
# stock.location id whose internal child locations are the storage tanks; empty: the sync skips the tanks
ODOO_TANK_PARENT_LOCATION_ID=

# Company portal sign-in for staff. All three are needed; otherwise the SSO routes answer 503.
# PORTAL_API_URL ends in /api.
PORTAL_API_URL=
PORTAL_WEB_URL=
PORTAL_APP_NAME=

# Portal emails, comma separated, that get EDIT on every active module at each portal sign-in.
# Case does not matter. Empty: nobody is made admin this way.
BOOTSTRAP_ADMIN_EMAILS=

# Central driver registry. VCF_URL alone is enough to read it; the account is for a later slice.
VCF_URL=
VCF_USERNAME=
VCF_PASSWORD=

# Daily pull, HH:MM in the plant's time zone (Asia/Jakarta, whatever the machine's zone), e.g. 18:15. At that time
# the API reads Odoo in full mode (as npm run sync:odoo -- --full) and then the driver registry, each only when it is
# configured above. A pull already running from the web button is skipped; a failure waits for the next day.
# Empty: no daily pull.
SYNC_DAILY_AT=

# Phone pushes. off: notifications are kept for the app's inbox only and pushes wait. fcm: Firebase Cloud Messaging
# (HTTP v1). Default: off.
PUSH_PROVIDER=
# fcm only, required: path of the service account key file (JSON) of the Firebase project. Keep it outside git.
FCM_SERVICE_ACCOUNT_FILE=

# Voice of the weighbridge answers. off: GET /api/weighbridge/speech answers 204 and the weighbridge program
# shows the text with a tone. supertonic: Supertonic 3 on this machine's CPU (see the README). Default: off.
TTS_ENGINE=
# Folder for the audio of each sentence, per engine, voice and speed; capped at 500 MB, least used removed first.
# Default: .data/tts-cache
TTS_CACHE_DIR=
# supertonic only. Folder with the seven model files; required, e.g. storage/tts/supertonic3
TTS_MODEL_DIR=
# supertonic only. Voice F1..F5 or M1..M5 (default F2), speed 0.5 to 2 (default 1.0), CPU threads (default 4).
TTS_VOICE=
TTS_SPEED=
TTS_THREADS=
# Folder for uploaded photos; each file is kept under a random key below it. Default: .data/files
FILE_STORAGE_DIR=
# The old weighbridge database, postgres://user:password@host:5432/database. Opened only by npm run legacy:import,
# in a read-only session; the API server never opens it. Empty: the import refuses to start.
LEGACY_DATABASE_URL=

# Document reading service for the registration post (scanned surat pengantar and delivery orders), e.g.
# http://<host>:<port>. Only this API calls it; the service never gets the database. Empty: POST
# /api/gate/scan-document answers 503.
OCR_API_URL=
# Seconds one reading may take before the scan route gives up; the scan is kept either way. 1 to 600, default 45.
OCR_TIMEOUT_S=
